# Server-only. Never copy secrets into VITE_* or commit .env.
DATA_DIR=docs
STATE_PATH=.local/career_quest.sqlite3
HR_TOKEN=
EMPLOYEE_TOKEN=
EMPLOYEE_ID=E0001
# Enable after adding a regular project API key locally. Never use an admin key.
AI_ENABLED=false
# Full base URL including /v1 when required; adapter appends /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_JSON_MODE=true
